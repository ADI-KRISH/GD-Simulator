# Local development only. Copy to .env (which is gitignored).
# Every value here is a dev-only placeholder — never put real credentials in
# this project. Nothing is hosted; everything binds to 127.0.0.1.

# --- App ---
APP_ENV=local
LOG_LEVEL=INFO
API_HOST=127.0.0.1
API_PORT=8000
# The Next.js dev server. Used for CORS.
FRONTEND_ORIGIN=http://localhost:3000

# --- Auth ---
# Dev signing key. Regenerate locally with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-insecure-secret-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=14

# --- PostgreSQL ---
POSTGRES_USER=gd
POSTGRES_PASSWORD=gd_dev_password
POSTGRES_DB=gd
POSTGRES_HOST=localhost
# 5442, not 5432 — this machine already runs a native PostgreSQL on the default.
POSTGRES_PORT=5442

# --- Redis (cache + Streams event bus) ---
REDIS_URL=redis://localhost:6389/0

# --- LiveKit (self-hosted in Docker) ---
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret_local_only_change_never_shipped

# --- MinIO (S3-compatible object storage) ---
MINIO_ENDPOINT=http://localhost:9010
MINIO_ROOT_USER=gd_minio
MINIO_ROOT_PASSWORD=gd_minio_dev_password
MINIO_BUCKET=gd-recordings

# --- Grafana ---
GRAFANA_ADMIN_PASSWORD=admin

# --- Object storage backend ---
# filesystem | minio. `filesystem` writes to services/media/ (gitignored) so
# audio ingestion works with nothing else running; switch to minio once the
# container is up.
OBJECT_STORE=filesystem

# --- Speech-to-text (FR-13) ---
# auto | whisper | stub. `auto` uses Whisper when faster-whisper is installed
# (see services/requirements-speech.txt) and otherwise falls back to a
# deterministic stub, so the pipeline runs before the model download.
STT_PROVIDER=auto
WHISPER_MODEL=base

# --- LLM layer (design §54) ---
# anthropic | openai | stub. `stub` is a deterministic offline provider: the
# full agentic evaluation pipeline runs and is testable with no API key and no
# network. For real evaluation set the provider, a model it serves, and a key:
#   LLM_PROVIDER=anthropic   LLM_MODEL=claude-opus-5
#   LLM_PROVIDER=openai      LLM_MODEL=gpt-4o-mini
LLM_PROVIDER=stub
LLM_MODEL=claude-opus-5
LLM_API_KEY=
LLM_MAX_TOKENS=2048
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3

# --- Evaluation versioning (design §40) ---
# Recorded with every evaluation so any score is reproducible. Bump these when
# prompts or agent definitions change.
PROMPT_VERSION=1.0
AGENT_VERSION=1.0

# --- Password hashing ---
# bcrypt work factor. 12 is the real default; the test suite lowers it.
BCRYPT_ROUNDS=12
